{
  "name": "XP \u2014 UGC Approvato",
  "description": "Assegna +150 XP quando un contenuto UGC viene approvato dall'admin.",
  "trigger": {
    "condition": "${ ((.trigger.data.approved == true) and (.trigger.changed_fields | index(\"approved\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "UGCSubmission"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "xp_ugc_approvato",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "awardXPOnActivity",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "awardXPOnActivity"
  }
}