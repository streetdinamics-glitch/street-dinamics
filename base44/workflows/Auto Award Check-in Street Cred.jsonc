{
  "name": "Auto Award Check-in Street Cred",
  "description": "Awards +150 Street Cred points when a fan checks into an event",
  "trigger": {
    "condition": "${ ((.trigger.data.checked_in == true) and (.trigger.old_data.checked_in != true)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Registration"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_award_check_in_street_cred",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "awardCheckinStreetCred",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "awardCheckinStreetCred"
  }
}