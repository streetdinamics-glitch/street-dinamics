{
  "name": "Mint Athlete Tokens at Tournament Start",
  "description": "When a Tournament status changes to in_progress, automatically mint AthleteToken cards for every registered athlete.",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"in_progress\") and (.trigger.changed_fields | index(\"status\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Tournament"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "mint_athlete_tokens_at_tournament_start",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "mintAthleteTokensAtTournamentStart",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "mintAthleteTokensAtTournamentStart"
  }
}