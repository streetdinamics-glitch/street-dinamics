{
  "name": "Emetti NFT reward UGC approvato",
  "description": "Quando un admin approva una UGC submission con reward_type=nft_card, emette automaticamente la NFT card al creator",
  "trigger": {
    "condition": "${ ((.trigger.data.approved == true) and (.trigger.data.reward_issued == false) and (.trigger.data.reward_type == \"nft_card\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "UGCSubmission"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "emetti_nft_reward_ugc_approvato",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "issueUGCNFTReward",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "issueUGCNFTReward"
  }
}