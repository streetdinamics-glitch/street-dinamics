{
  "name": "Execute NFT Clip Snapshot at Tournament End",
  "description": "When a Tournament ends (status=completed), take snapshot of card holders and distribute NFT Clips to each holder.",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"completed\") and (.trigger.data.snapshot_completed == false) and (.trigger.changed_fields | index(\"status\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Tournament"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "execute_nft_clip_snapshot_at_tournament_end",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "executeTournamentSnapshot",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "executeTournamentSnapshot"
  }
}