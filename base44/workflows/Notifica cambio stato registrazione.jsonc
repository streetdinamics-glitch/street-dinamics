{
  "name": "Notifica cambio stato registrazione",
  "description": "Invia email e notifica in-app quando la registrazione di un atleta viene confermata o rifiutata",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"confirmed\" or .trigger.data.status == \"rejected\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Registration"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notifica_cambio_stato_registrazione",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyRegistrationStatusChange",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyRegistrationStatusChange"
  }
}