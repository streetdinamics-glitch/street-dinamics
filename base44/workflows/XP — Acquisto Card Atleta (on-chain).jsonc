{
  "name": "XP \u2014 Acquisto Card Atleta (on-chain)",
  "description": "Assegna +75 XP quando un utente acquista una card atleta NFT.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "NFTOwnership"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "xp_acquisto_card_atleta_on_chain",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "awardXPOnActivity",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "awardXPOnActivity"
  }
}