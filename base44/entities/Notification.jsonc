{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Recipient email"
    },
    "type": {
      "type": "string",
      "enum": [
        "event",
        "milestone",
        "voting",
        "deal",
        "reward"
      ],
      "description": "Notification type"
    },
    "title": {
      "type": "string",
      "description": "Notification title"
    },
    "message": {
      "type": "string",
      "description": "Notification message"
    },
    "related_entity_id": {
      "type": "string",
      "description": "ID of related entity (event, milestone, etc)"
    },
    "related_entity_type": {
      "type": "string",
      "description": "Type of related entity"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether user has read the notification"
    },
    "action_url": {
      "type": "string",
      "description": "URL to navigate to when notification is clicked"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "When notification was created"
    }
  },
  "required": [
    "user_email",
    "type",
    "title",
    "message"
  ]
}