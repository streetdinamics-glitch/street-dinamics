{
  "name": "FanReward",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email utente che riceve il premio (fan o atleta)"
    },
    "user_name": {
      "type": "string",
      "description": "Nome display utente"
    },
    "event_id": {
      "type": "string",
      "description": "Evento associato (opzionale)"
    },
    "fan_email": {
      "type": "string",
      "description": "Alias legacy \u2014 usare user_email"
    },
    "fan_name": {
      "type": "string",
      "description": "Alias legacy \u2014 usare user_name"
    },
    "reward_type": {
      "type": "string",
      "description": "Tipo premio: street_cred_points, nft_card, token_drop, badge, cashback_boost, early_access, custom, digital_badge, exclusive_content, nft_collectible, merchandise_voucher, vip_access"
    },
    "reward_name": {
      "type": "string",
      "description": "Nome del premio / traguardo"
    },
    "reward_description": {
      "type": "string",
      "description": "Descrizione del premio"
    },
    "reward_value": {
      "type": "string",
      "description": "Valore specifico del premio (punti, tipo badge, descrizione NFT, ecc.)"
    },
    "milestone_id": {
      "type": "string",
      "description": "ID del traguardo RewardItem che ha generato questo premio"
    },
    "source": {
      "type": "string",
      "enum": [
        "admin_manual",
        "system_auto",
        "event_trigger",
        "ugc_reward"
      ],
      "default": "system_auto",
      "description": "Come \u00e8 stato generato il premio"
    },
    "points_required": {
      "type": "number",
      "description": "Punti richiesti (legacy)"
    },
    "reward_image_url": {
      "type": "string",
      "description": "URL immagine premio"
    },
    "reward_note": {
      "type": "string",
      "description": "Note interne dello staff"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "description": "Quando \u00e8 stato emesso il premio"
    },
    "earned_at": {
      "type": "string",
      "format": "date-time",
      "description": "Alias di issued_at (legacy)"
    },
    "redeemed": {
      "type": "boolean",
      "default": false,
      "description": "Se il premio \u00e8 stato riscattato"
    },
    "redeemed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Quando \u00e8 stato riscattato"
    },
    "redemption_code": {
      "type": "string",
      "description": "Codice univoco per il riscatto"
    }
  },
  "required": [
    "user_email",
    "reward_type",
    "reward_name"
  ]
}