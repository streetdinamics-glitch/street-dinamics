{
  "name": "Sponsor",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string",
      "description": "Company name"
    },
    "contact_person": {
      "type": "string",
      "description": "Contact person name"
    },
    "email": {
      "type": "string",
      "description": "Contact email"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "website": {
      "type": "string",
      "description": "Company website"
    },
    "logo_url": {
      "type": "string",
      "description": "Company logo URL"
    },
    "tier": {
      "type": "string",
      "enum": [
        "platinum",
        "gold",
        "silver",
        "bronze"
      ],
      "description": "Sponsorship tier"
    },
    "contract_start_date": {
      "type": "string",
      "format": "date"
    },
    "contract_end_date": {
      "type": "string",
      "format": "date"
    },
    "sponsorship_amount": {
      "type": "number",
      "description": "Annual sponsorship amount in USD"
    },
    "benefits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Sponsorship benefits"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "expired",
        "cancelled"
      ],
      "default": "pending"
    }
  },
  "required": [
    "company_name",
    "email"
  ]
}